# Copy this file to .env and adjust as needed.
# Any field on the Settings class in config.py can be overridden here.

APP_ENV=development
DEBUG=true

LOG_LEVEL=INFO

DATABASE_URL=sqlite:///database/resume_analyzer.db

MAX_RESUME_SIZE_MB=5
ATS_PASS_THRESHOLD=70
MATCH_PASS_THRESHOLD=60

SEMANTIC_MODEL_NAME=all-MiniLM-L6-v2

# --- Phase 7: Gemini AI suggestions ---
# Get a key at https://aistudio.google.com/apikey — required for AI Resume Suggestions.
# Never commit a real key. This file only documents the variable name.
GEMINI_API_KEY=your_api_key_here
# Optional override — see https://ai.google.dev/gemini-api/docs/models for current model IDs.
GEMINI_MODEL=gemini-2.5-flash
